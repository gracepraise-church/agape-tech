# Set to the final HTTPS origin (no path, query, fragment, or trailing path) before production build.
# When unset, the site emits no canonical/sitemap URLs and requests no indexing.
NEXT_PUBLIC_SITE_URL=

# Server-only Resend credentials. Use a sender address verified with Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional reply-to for the acknowledgement email.
CONTACT_REPLY_TO_EMAIL=
# Visitor acknowledgements are disabled unless explicitly enabled.
CONTACT_SEND_ACKNOWLEDGEMENT=false

# Optional Cloudflare Turnstile. Set BOTH keys for the same widget/site at build AND runtime.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
