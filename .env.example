# Set this to the production origin before configuring canonical URLs and sitemap output.
NEXT_PUBLIC_SITE_URL=

# Server-only Resend credentials. Use a sender address verified with Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional reply-to for the acknowledgement email.
CONTACT_REPLY_TO_EMAIL=
# Visitor acknowledgements are disabled unless explicitly enabled.
CONTACT_SEND_ACKNOWLEDGEMENT=false

# Optional Cloudflare Turnstile. Configure both keys to enable server verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
